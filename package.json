{
  "name": "video-ads-studio-remotion",
  "version": "1.0.0",
  "description": "Programmatic vertical video ad engine (Video-as-Code) built with Remotion v4, React 19, TypeScript, Zod, and FFmpeg for Reels, TikTok, and Meta Ads.",
  "license": "MIT",
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "preprocess": "node scripts/preprocess-raw.mjs",
    "typecheck": "tsc --noEmit",
    "render:a": "remotion render PintaPlopReelA out/reel-a-hogar.mp4",
    "render:b": "remotion render PintaPlopReelB out/reel-b-obra.mp4",
    "render:storm": "remotion render PintaPlopVenierTormentas out/reel-venier-tormentas.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/fonts": "4.0.545",
    "@remotion/media": "4.0.545",
    "@remotion/transitions": "4.0.545",
    "@remotion/zod-types": "4.0.545",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.545",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/web": "^0.0.166",
    "typescript": "^5.8.2"
  }
}
